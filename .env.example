# Add these in Vercel → Project → Settings → Environment Variables
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# Optional: separate prices for each offering (create in Stripe Dashboard)
STRIPE_PRICE_DISCOVERY=price_...
STRIPE_PRICE_PROJECT=price_...
STRIPE_PRICE_RETAINER=price_...

# Custom invoice payments use price_data dynamically — no extra env needed.

# Optional restricted key for Checkout Sessions, PaymentIntents and Charges read access
STRIPE_RECEIPT_KEY=

# Sends the custom PDF receipt and agreement after Stripe confirms payment.
# Verify this sender/domain in Resend before going live.
RESEND_API_KEY=re_...
RECEIPT_FROM_EMAIL=receipts@lukaah.com
STRIPE_WEBHOOK_SECRET=whsec_...
